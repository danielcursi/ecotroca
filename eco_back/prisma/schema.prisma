// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:postgre@localhost:5432/ecotroca?schema=public"
}

enum StatusItem {
  DISPONIVEL
  RESERVADO
  INDISPONIVEL
}

enum StatusProposta {
  PENDENTE
  ACEITA
  RECUSADA
  CANCELADA
}

model Usuario {
  id_usuario    Int       @id @default(autoincrement())
  nome          String
  email         String    @unique
  senha_hash    String
  telefone      String
  cidade        String
  bairro        String
  data_cadastro DateTime  @default(now())

  // Relacionamentos
  itens         Item[]         @relation("UsuarioItens")
  propostas     PropostaTroca[] @relation("UsuarioPropostas")
  mensagens     Mensagem[]     @relation("UsuarioMensagens")
}

model Item {
  id_item                Int       @id @default(autoincrement())
  id_usuario_proprietario Int
  id_categoria           Int
  titulo                 String
  descricao              String
  condicao               String
  foto_uris              String
  data_publicacao        DateTime  @default(now())
  status_item            StatusItem

  // Relacionamentos
  usuario                Usuario   @relation("UsuarioItens", fields: [id_usuario_proprietario], references: [id_usuario])
  categoria              Categoria @relation(fields: [id_categoria], references: [id_categoria])
  propostas_oferecido    PropostaTroca[] @relation("ItemOferecido")
  propostas_desejado     PropostaTroca[] @relation("ItemDesejado")
}

model Categoria {
  id_categoria   Int     @id @default(autoincrement())
  nome_categoria String
  descricao      String?

  // Relacionamentos
  itens          Item[]
}

model PropostaTroca {
  id_proposta             Int       @id @default(autoincrement())
  id_item_oferecido       Int
  id_item_desejado        Int
  id_usuario_proponente   Int
  status_proposta         StatusProposta
  data_proposta           DateTime @default(now())
  data_atualizacao_status DateTime?

  // Relacionamentos
  item_oferecido          Item     @relation("ItemOferecido", fields: [id_item_oferecido], references: [id_item])
  item_desejado           Item     @relation("ItemDesejado", fields: [id_item_desejado], references: [id_item])
  usuario_proponente      Usuario  @relation("UsuarioPropostas", fields: [id_usuario_proponente], references: [id_usuario])
  mensagens               Mensagem[]
}

model Mensagem {
  id_mensagem        Int       @id @default(autoincrement())
  id_proposta_troca  Int
  id_usuario_remetente Int
  conteudo_mensagem  String
  data_envio         DateTime  @default(now())
  lida               Boolean   @default(false)

  // Relacionamentos
  proposta_troca     PropostaTroca @relation(fields: [id_proposta_troca], references: [id_proposta])
  usuario_remetente  Usuario       @relation("UsuarioMensagens", fields: [id_usuario_remetente], references: [id_usuario])
}